{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__game",
          "__BUILD_VERSION__"
        ]
      }
    ]
  }
}
