<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: a `hostUrl` pointing at a laptop on the LAN is plain http,
  which API 28+ blocks by default. The release APK keeps that block.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application android:usesCleartextTraffic="true" tools:ignore="UnusedAttribute" />
</manifest>
